# ===================================================================
# 火山引擎（火山 ASR / 火山 TTS）
# 控制台：https://console.volcengine.com/
# 获取：访问控制 → API Access Key → 创建并下载
# ===================================================================
VOLC_APPID=your_volc_appid
VOLC_TOKEN=your_volc_token_here
VOLC_CLUSTER=volcano_tts

# ===================================================================
# 豆包大模型（doubao-pro，作为贴身秘书）
# 获取：火山引擎 → 豆包大模型 → 在线推理 → 创建 API Key
# ===================================================================
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-pro

# ===================================================================
# 组织部 → Claude Agent SDK
# 获取：https://console.anthropic.com/
# ===================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-4-20250514

# ===================================================================
# 宣传部 → Gemini
# 获取：https://aistudio.google.com/apikey
# ===================================================================
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-pro

# ===================================================================
# 社工部 → OpenAI Codex（gpt-5-codex）
# 获取：https://platform.openai.com/api-keys
# ===================================================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-codex

# ===================================================================
# 政法委 → DeepSeek（OpenAI 兼容）
# 获取：https://platform.deepseek.com/api_keys
# ===================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner

# ===================================================================
# 运行模式（可选）
# ===================================================================
# LOG_LEVEL=INFO
# AUDIO_DEVICE_NAME=USB Audio Device